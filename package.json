{
  "name": "edictfall",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "docs": "node -e \"process.env.GEN_DOCS='1';require('child_process').execSync('npx vitest run tests/docs.test.ts',{stdio:'inherit'})\""
  },
  "dependencies": {
    "peerjs": "^1.5.5",
    "pixi.js": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
